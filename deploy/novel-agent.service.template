[Unit]
Description=LangGraph Novel Agent Backend
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__APP_DIR__/backend
EnvironmentFile=-/etc/novel-agent/novel-agent.env
Environment=PYTHONUNBUFFERED=1
Environment=WEBNOVEL_HOST=127.0.0.1
Environment=WEBNOVEL_PORT=__BACKEND_PORT__
ExecStart=__APP_DIR__/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port __BACKEND_PORT__
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
